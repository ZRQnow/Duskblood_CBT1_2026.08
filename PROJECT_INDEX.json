{
  "schema_version": "3.0.0",
  "project": "Duskblood-CBT1",
  "purpose": "The Duskbloods CBT1 / Global Network Test industry research base",
  "ai_entrypoint": "AGENTS.md",
  "canonical_datasets": {
    "sources": "source_register.jsonl",
    "assets": "asset_manifest.jsonl",
    "evidence": "observations.jsonl",
    "social_reception": "social_reception.jsonl",
    "claims": "claims.json",
    "analysis_index": "analysis_index.json",
    "analysis_prompt": "analysis/PROMPT.md"
  },
  "directory_roles": {
    "images": "image, screenshot and animated-image assets",
    "videos": "video assets",
    "interviews": "interview, translation and interview-derived text assets",
    "analysis": "research reports and the reusable game-product industry-analysis prompt"
  },
  "id_graph": [
    "source_id -> asset_id",
    "asset_id -> evidence_id",
    "evidence_id -> analysis",
    "evidence_id -> claim_id"
  ],
  "truth_priority": [
    "primary_official",
    "firsthand_test_observation",
    "direct_interview",
    "professional_media",
    "community_report",
    "unverified_social"
  ],
  "machine_rules": {
    "unknown_value": null,
    "dates": "ISO 8601",
    "jsonl": "one independent record per line",
    "analysis_requires_evidence_id": true,
    "claims_require_scope_note": true,
    "asset_paths_are_repository_relative": true
  }
}
